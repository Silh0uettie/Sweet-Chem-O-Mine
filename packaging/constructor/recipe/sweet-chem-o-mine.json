{
  "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
  "menu_name": "Sweet Chem O' Mine",
  "menu_items": [
    {
      "name": "Sweet Chem O' Mine",
      "description": "Chemical UMAP Explorer",
      "command": [
        "{{ BASE_PYTHONW }}",
        "{{ BASE_PREFIX }}/cwp.py",
        "{{ PREFIX }}",
        "{{ PYTHONW }}",
        "-m",
        "sweet_chem_o_mine"
      ],
      "icon": "{{ MENU_DIR }}/sweet-chem-o-mine.ico",
      "activate": true,
      "terminal": false,
      "platforms": {
        "win": {
          "desktop": true,
          "app_user_model_id": "SweetChemOMine.Desktop"
        }
      }
    }
  ]
}
